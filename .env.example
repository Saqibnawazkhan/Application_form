# ---------------------------------------------------------------
# Orbit Innovations - Careers page configuration
# Copy this file to ".env" and fill in real values before deploying.
# ---------------------------------------------------------------

# Port the server listens on
PORT=3000

# Public URL of the page (used for the Instagram share link + canonical tag).
# Example: https://orbitinnovations.com/apply
PUBLIC_URL=http://localhost:3000

# Password for the admin dashboard at /admin (change this!)
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Secret used to sign admin session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Set to "true" when running behind a reverse proxy (nginx, Caddy, Render, Railway…)
# so rate limiting sees the real client IP and cookies are marked Secure.
TRUST_PROXY=false

# Max CV upload size in megabytes
MAX_UPLOAD_MB=5
