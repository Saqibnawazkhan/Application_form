# ---------------------------------------------------------------
# Orbit Innovations - Careers page configuration
# Copy this file to ".env" and fill in real values before deploying.
# On Vercel, set these in Project Settings -> Environment Variables.
# ---------------------------------------------------------------

# Postgres connection string. Use the POOLED connection URL
# (Neon calls it "Pooled connection"; it has "-pooler" in the host).
# Vercel's Postgres integration sets POSTGRES_URL for you automatically.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Password for the admin dashboard at /admin (change this!)
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Secret used to sign admin session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Cosmetic only - printed in the local startup banner. The share button builds
# its link from window.location, so this is not needed on Vercel.
PUBLIC_URL=http://localhost:3000

# Max CV upload size in megabytes.
# Vercel rejects serverless request bodies over 4.5 MB, so keep this at 4 or below.
MAX_UPLOAD_MB=4

# Port for local development
PORT=3000

# Set to "true" when self-hosting behind a reverse proxy (nginx, Caddy, ...).
# Vercel is detected automatically, so leave this alone there.
TRUST_PROXY=false
